# Copy this file to .env.local and fill it in. .env.local is git-ignored.

# --- Required -------------------------------------------------------------

# Supabase project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# The anon key, or a newer "publishable" key. Safe in the browser: row-level security is the guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key, or a newer "secret" key. Server only. It bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key. Used for the agent, extraction, re-rank and moderation.
# Either a key from https://platform.claude.com, or a gateway key (next setting).
ANTHROPIC_API_KEY=
# Only when going through a gateway that speaks the Anthropic Messages API.
# MIT Parley: use https://parley.api.mit.edu with a key generated at parley.mit.edu.
# Leave unset to call Anthropic directly. The app has its own variable for this
# because tools such as Claude Code export ANTHROPIC_BASE_URL into the processes
# they start, and that would win over this file.
# OFFHOURS_LLM_BASE_URL=https://parley.api.mit.edu
# After filling these in, run `npm run check:llm`.

# Any long random string. Scheduled jobs must send "Authorization: Bearer <this>".
CRON_SECRET=

# --- Optional -------------------------------------------------------------

# Voyage AI key for embeddings. Without it the app still runs, but interest
# matching is off (the matcher falls back to mood and social fit only).
VOYAGE_API_KEY=
# Must output 1024 dimensions to match the vector columns in the schema.
# VOYAGE_MODEL=voyage-3.5

# Live activity sources. Without them the catalog is the seed file only.
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=

# Model overrides. A gateway may use different ids: `npm run check:llm` lists them.
# OFFHOURS_AGENT_MODEL=claude-opus-5-5
# OFFHOURS_WORKER_MODEL=claude-haiku-5-5
# Three request features need Anthropic's own API (message threads, refusal
# fallback, eager tool input). They are used against Anthropic and held back
# from gateways; MIT Parley rejects them. Force with on or off.
# OFFHOURS_LLM_EXTRAS=on

# Ranker variant for the ablation: mood_profile (default) or profile_only.
# OFFHOURS_RANKER_VARIANT=mood_profile
# Set to "off" to skip the LLM re-rank and use the heuristic order.
# OFFHOURS_LLM_RERANK=off
